# ============================================================================
# RASPBERRY PI 5 CYBERSECURITY LAB - ENVIRONMENT VARIABLES
# ============================================================================
# IMPORTANT: This is a TEMPLATE file. Copy to .env and update with your values.
# NEVER commit .env file to Git - it contains sensitive credentials!
# Add '.env' to your .gitignore to prevent accidental commits
# ============================================================================

# System Configuration
TZ=Australia/Sydney

# ============================================================================
# PI-HOLE (DNS-LEVEL SECURITY & AD BLOCKING)
# ============================================================================
# Pi-hole provides network-wide DNS filtering and ad-blocking
# Every DNS query from your network goes through this first
PIHOLE_PASSWORD=PiHole-@Shield#2026!
UPSTREAM_DNS=8.8.8.8

# ============================================================================
# N8N (AUTOMATION & INCIDENT RESPONSE WORKFLOWS)
# ============================================================================
# n8n orchestrates automated responses to security events
# Can trigger alerts, escalate incidents, run security scans
N8N_USER=ryank
N8N_PASSWORD=n8n-@Automate#2026!
N8N_SECURE_COOKIE=false

# ============================================================================
# NTOPNG (REAL-TIME NETWORK MONITORING & THREAT DETECTION)
# ============================================================================
# ntopng captures and analyzes all network traffic
# Detects anomalies, malware signatures, DDoS attempts
NTOPNG_PASSWORD=ntop-@Monitor#2026!

# ============================================================================
# DVWA (VULNERABLE TARGET FOR OFFENSIVE SECURITY TESTING)
# ============================================================================
# Damn Vulnerable Web Application - intentionally weak web app
# Used for practicing penetration testing and vulnerability exploitation
DVWA_DB_PASSWORD=dvwa-@Target#2026!

# ============================================================================
# TOR PROXY (ANONYMITY & PRIVACY TESTING)
# ============================================================================
# Routes traffic through Tor network for anonymous testing
# Useful for testing application behavior through VPN/proxy
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051

# ============================================================================
# OPTIONAL: OPENCLAW AI AGENT
# ============================================================================
# AI assistant for analyzing security events and logs
# Uncomment and add your key when integrated
# OPENCLAW_API_KEY=your_openclaw_key_here
# OPENCLAW_WEBHOOK_URL=https://your.webhook.url

# ============================================================================
# OPTIONAL: ADVANCED MONITORING (INFLUXDB TIME-SERIES DATABASE)
# ============================================================================
# Stores historical network metrics for trend analysis
# Uncomment if you want long-term traffic pattern analysis
# INFLUXDB_DB=ntopng
# INFLUXDB_ADMIN_USER=admin
# INFLUXDB_ADMIN_PASSWORD=influx-@Monitor#2026!

# ============================================================================
# DOCKER NETWORK CONFIGURATION
# ============================================================================
# Isolated network for lab services
DOCKER_NETWORK=lab-network

# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================
# ✅ Change all default passwords immediately
# ✅ Store this .env file securely (chmod 600 .env)
# ✅ Use strong, unique passwords (min 16 chars recommended)
# ✅ Rotate passwords every 90 days
# ✅ NEVER commit .env file to Git
# ✅ Keep .env.example up to date (without secrets)
# ✅ Use environment-specific files (.env.prod, .env.dev)
# ============================================================================
